PORT=5000

NODE_ENV=development

CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/buglens?retryWrites=true&w=majority

JWT_SECRET=GENERATE_A_RANDOM_SECRET
JWT_EXPIRES_IN=7d

AUTH_COOKIE_NAME=buglens_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

ENCRYPTION_KEY=GENERATE_A_32_BYTE_BASE64_KEY

AI_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=qwen/qwen3.8-27b

MAIL_SERVICE=gmail
MAIL_USER=yourgmail@gmail.com
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
MAIL_FROM="BugLens <yourgmail@gmail.com>"

RESET_PASSWORD_URL=http://localhost:5173/reset-password